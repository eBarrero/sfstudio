{
  "name": "sfstudio",
  "private": true,
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "engines": {
    "node": ">=24.22.1 <25"
  },
  "workspaces": [
    "api",
    "app"
  ],
  "scripts": {
    "start": "npm --workspace api run start",
    "build": "npm --workspace api run build && npm --workspace app run build",
    "typecheck": "npm --workspace api run typecheck && npm --workspace app run typecheck",
    "lint": "npm --workspace api run lint && npm --workspace app run lint",
    "test": "npm --workspace app run test",
    "audit": "npm audit --omit=dev --audit-level=high",
    "audit:all": "npm audit"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@vitejs/plugin-react": "^4.3.3",
    "globals": "^15.11.0",
    "typescript-eslint": "^8.12.2"
  }
}
